# Outreach OAuth application credentials, from the Outreach developer portal
# (Your app -> Outreach API access). Use the DEVELOPMENT tab's credentials until
# the app is published; production credentials only work on a published app.
OUTREACH_CLIENT_ID=your_outreach_oauth_application_id
OUTREACH_CLIENT_SECRET=your_outreach_application_secret

# Must match a callback URL registered on the app, exactly.
OUTREACH_REDIRECT_URI=https://127.0.0.1:5555/callback

# Optional. Space-separated. Every scope listed here must also be ticked on the
# app in the developer portal or authorization fails with invalid_scope.
# Leave unset to request the defaults in src/login.ts.
# OUTREACH_SCOPES=accounts.all prospects.all sequences.all sequenceStates.all
