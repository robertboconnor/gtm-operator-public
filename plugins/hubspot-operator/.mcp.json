        "8082"
      ],
      "cwd": "."
    },
    "salesforce-sobject-deletes": {
      "command": "bash",
      "args": [
        "./bin/salesforce-mcp-remote.sh",
        "sobject-deletes",
        "8083"
      ],
      "cwd": "."
    }
