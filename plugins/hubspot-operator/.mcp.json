      "command": "node",
      "args": [
        "./dist/server.js"
      ],
      "cwd": "."
    },
    "salesforce-sobject-all": {
      "command": "bash",
      "args": [
        "./bin/salesforce-mcp-remote.sh",
        "sobject-all",
