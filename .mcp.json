{
  "mcpServers": {
    "hubspot-operator": {
      "command": "node",
      "args": [
        "./plugins/hubspot-operator/dist/server.js"
      ],
      "cwd": "."
    },
    "outreach-operator": {
      "command": "node",
      "args": [
        "./plugins/outreach-operator/dist/server.js"
      ],
      "cwd": "."
    },
    "salesforce-sobject-all": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.37",
        "https://api.salesforce.com/platform/mcp/v1/platform/sobject-all",
        "8080",
        "--static-oauth-client-info",
        "{\"client_id\":\"YOUR_SALESFORCE_CONNECTED_APP_CLIENT_ID\",\"client_secret\":\"\"}"
      ]
    },
    "salesforce-api-context": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.37",
        "https://api.salesforce.com/platform/mcp/v1/platform/salesforce-api-context",
        "8081",
        "--static-oauth-client-info",
        "{\"client_id\":\"YOUR_SALESFORCE_CONNECTED_APP_CLIENT_ID\",\"client_secret\":\"\"}"
      ]
    },
    "salesforce-metadata-experts": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.37",
        "https://api.salesforce.com/platform/mcp/v1/platform/metadata-experts",
        "8082",
        "--static-oauth-client-info",
        "{\"client_id\":\"YOUR_SALESFORCE_CONNECTED_APP_CLIENT_ID\",\"client_secret\":\"\"}"
      ]
    },
    "salesforce-sobject-deletes": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.1.37",
        "https://api.salesforce.com/platform/mcp/v1/platform/sobject-deletes",
        "8083",
        "--static-oauth-client-info",
        "{\"client_id\":\"YOUR_SALESFORCE_CONNECTED_APP_CLIENT_ID\",\"client_secret\":\"\"}"
      ]
    }
  }
}
